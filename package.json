{
  "name": "spiral-dynamics-test",
  "version": "1.0.0",
  "description": "TypeScript module for Graves Spiral Dynamics testing",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "test:simple": "jest --testPathPattern=simple",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "start": "node dist/main.js",
    "start:tunnel": "cross-env USE_TUNNEL=true node dist/main.js",
    "start:tunnel:win": "powershell -Command \"$env:USE_TUNNEL='true'; node dist/main.js\"",
    "start:dev": "tsc --watch & node --watch dist/main.js",
    "start:dev:tunnel": "tsc --watch & cross-env USE_TUNNEL=true node --watch dist/main.js",
    "example": "tsc && node dist/examples/basic-usage.js",
    "example-24": "tsc && node dist/examples/spiral-dynamics-24-test.js",
    "example-validation": "tsc && node dist/examples/full-validation-example.js",
    "lint": "echo \"Linting not configured yet\""
  },
  "keywords": [
    "spiral-dynamics",
    "graves",
    "psychology",
    "testing",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@nestjs/testing": "^11.1.5",
    "@types/jest": "^29.5.14",
    "@types/localtunnel": "^2.0.4",
    "@types/node": "^20.0.0",
    "@types/supertest": "^6.0.3",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "localtunnel": "^2.0.2",
    "supertest": "^7.1.3",
    "ts-jest": "^29.4.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@kirillchervotkin/alice-nestjs-framework": "github:kirillchervotkin/alice-nestjs-framework",
    "@nestjs/common": "^11.1.4",
    "@nestjs/core": "^11.1.4",
    "@nestjs/platform-express": "^11.1.4",
    "@types/nodemailer": "^6.4.17",
    "axios": "^1.10.0",
    "nodemailer": "^7.0.5",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1"
  }
}
